# Copy to .env (never commit).
LITELLM_TAG=            # choose and pin a reviewed release
LITELLM_MASTER_KEY=sk-change-me
AWS_REGION=us-east-1
AWS_PROFILE=default
BEDROCK_CHAT_MODEL=bedrock/REPLACE_WITH_MODEL_OR_INFERENCE_PROFILE_ID
BEDROCK_EMBED_MODEL=bedrock/amazon.titan-embed-text-v2:0

# App -> gateway (virtual key issued from LiteLLM, not the master key)
GATEWAY_URL=http://localhost:4000
GATEWAY_API_KEY=sk-virtual-key
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/rag
EMBED_DIM=1024
